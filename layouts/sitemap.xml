{{- /* Only indexable, canonical content: the home page and the posts. Tags, section listings and pagination are left out on purpose. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.Home.Permalink }}</loc>
    <lastmod>{{ site.Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
  </url>
  {{- range site.RegularPages }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
</urlset>
